{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["pnku"],
  "contact": {
    "homepage": "https://pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Fishing-Rod-Variants",
    "issues": "https://github.com/pnk2u/More-Fishing-Rod-Variants/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.pnku.mstv_mfrv.MoreFishingRodVariants"
    ],
    "client": [
      "de.pnku.mstv_mfrv.MoreFishingRodVariantsClient"
    ]
  },
  "mixins": [
    "mstv-mfrv.mixins.json",
    {
      "config": "mstv-mfrv.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">${minecraft_version_0} <${minecraft_version_1}",
		"java": ">=${java_version}",
		"fabric-api": "*",
        "mstv-base": ">=${mstv_version}"
	},
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.lieonlion.dev"
      }
    },
    "mc-publish": {
      "modrinth": "J7YAdDyQ",
      "curseforge": "1096916",
      "dependencies": [
        "fabric-api(required)#(ignore)"
      ]
    }
  }
}
